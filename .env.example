# Compose database only. Use a strong local value before docker compose up -d.
UNIGATE_DB_PASSWORD=
# Backend configuration (export variables in your process, or use tools/dev/local.py).
UNIGATE_DB_URL=jdbc:postgresql://127.0.0.1:5432/unigate
UNIGATE_DB_USER=unigate
# Base64-encoded 32 random bytes. Keep stable across restarts.
UNIGATE_MASTER_KEY=
UNIGATE_BOOTSTRAP_USERNAME=admin
UNIGATE_BOOTSTRAP_PASSWORD=
UNIGATE_ALLOWED_ORIGIN=http://localhost:5173
UNIGATE_COOKIE_SECURE=false
# Keep keys/revocation markers outside database backups; never replace with an old snapshot.
UNIGATE_KEY_DIRECTORY=.local/keys
UNIGATE_STORAGE_DIRECTORY=.local/artifacts
