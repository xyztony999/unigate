# UniGate 后端生产环境配置模板(Go 静态单二进制, 无 JVM, 不需要任何 JAVA_OPTS 调优)。
# 拷贝到服务器 /opt/unigate/unigate.env 并填入真实值: chmod 600, 仅存服务器, 永不入库。
# 各变量含义见根目录 .env.example 与 backend/README.md。
# 宝塔模式(DEPLOY_MODE=bt): 宝塔以 source 加载本文件, 须在首行加 `set -a`、末行加 `set +a`,
#   否则变量不 export, Go 进程读不到密钥会启动失败。systemd 模式保持纯 KEY=VALUE(不加 set)。

# 程序默认 8080; 本部署服务器 8080 已被占用, 用 8090。
# 改此端口须同步 nginx proxy_pass 与 deploy 的 APP_PORT。
PORT=8090

# 与宝塔面板创建 unigate 数据库时设置的密码一致(面板 → 数据库 → PostgreSQL)
# jdbc:postgresql:// 前缀会被自动转换为 pgx 格式, 也可直接写 postgres://127.0.0.1:5432/unigate
UNIGATE_DB_URL=jdbc:postgresql://127.0.0.1:5432/unigate
UNIGATE_DB_USER=unigate
UNIGATE_DB_PASSWORD=<数据库密码>

# 生成: openssl rand -base64 32 。一旦投入生产不可更换, 否则历史活动数据无法解密。
UNIGATE_MASTER_KEY=<Base64 编码的 32 字节随机秘密>

# 首次启动创建管理员; 登录后强制改密, 重启不会覆盖已有账号。
UNIGATE_BOOTSTRAP_USERNAME=admin
UNIGATE_BOOTSTRAP_PASSWORD=<至少 12 位>

# 浏览器实际访问地址。生产默认 Secure Cookie, 不需要再设置 UNIGATE_COOKIE_SECURE。
UNIGATE_ALLOWED_ORIGIN=https://<你的域名>

# 活动数据密钥与受管文件目录。严禁随数据库备份回滚。
UNIGATE_KEY_DIRECTORY=/opt/unigate/keys
UNIGATE_STORAGE_DIRECTORY=/opt/unigate/artifacts
