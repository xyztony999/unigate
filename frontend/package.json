{
  "name": "unigate-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/record-coverage.mjs",
    "generate:contract": "python -X utf8 scripts/generate_contract.py"
  },
  "dependencies": {
    "@zxing/browser": "0.2.0",
    "@zxing/library": "0.21.3",
    "qrcode": "1.5.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "4.1.0",
    "@vue/test-utils": "2.4.6",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.0",
    "vue-tsc": "3.3.13"
  }
}
